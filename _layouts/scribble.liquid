<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include head.liquid %}
  <style>
    /* Styling tambahan supaya list-nya cantik */
    .scribble-trigger {
      cursor: pointer;
      text-decoration: none !important;
      display: block;
      padding: 15px 0;
      border-bottom: 1px solid rgba(0,0,0,0.1);
      transition: all 0.3s ease;
    }
    .scribble-trigger:hover {
      padding-left: 10px;
      color: var(--global-theme-color) !important;
    }
    .scribble-content {
      padding: 20px;
      background-color: rgba(0,0,0,0.02);
      border-radius: 8px;
      margin-bottom: 20px;
    }
    .post-date {
      font-family: monospace;
      font-size: 0.9rem;
      margin-right: 15px;
      opacity: 0.6;
    }
  </style>
</head>

<body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
  {% include header.liquid %}

  <div class="container mt-5" role="main">
    <header class="post-header mb-5">
      <h1 class="post-title font-weight-bold">{{ page.title }}</h1>
      
      {% if page.subtitle %}
        <p class="page-subtitle font-weight-bold" style="color: var(--global-theme-color) !important;">
          {{ page.subtitle }}
        </p>
      {% endif %}
      
      {% if page.description %}
        <div class="post-description">
          {{ page.description | markdownify }}
        </div>
      {% endif %}
      <hr>
    </header>

    <div class="scribbles-list">
      {% assign entries = site.scribbles | sort: 'date' | reverse %}
      {% for entry in entries %}
        <div class="scribble-item">
          <a class="scribble-trigger h5 font-weight-bold" 
             data-toggle="collapse" 
             href="#entry-{{ forloop.index }}" 
             role="button" 
             aria-expanded="false">
            <span class="post-date">{{ entry.date | date: "%Y-%m-%d" }}</span>
            {{ entry.title }}
          </a>

          <div class="collapse" id="entry-{{ forloop.index }}">
            <div class="scribble-content card-body">
              {{ entry.content }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="mt-5">
      {{ content }}
    </div>

  </div>

  {% include footer.liquid %}
  {% include scripts.liquid %}
</body>
</html>
