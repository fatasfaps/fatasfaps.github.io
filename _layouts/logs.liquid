<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include head.liquid %}
  <style>
    .log-item { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      padding: 25px 10px; 
      border-bottom: 1px solid var(--global-divider-color); 
    }
    
    /* Sisi Kiri: Teks */
    .log-content { flex: 1; padding-right: 20px; }
    .log-title { font-size: 1.25rem; font-weight: 600; display: block; margin-bottom: 4px; }
    .log-desc { font-size: 0.95rem; opacity: 0.6; margin: 0; line-height: 1.4; }

    /* Sisi Kanan: Tombol Horizontal */
    .log-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .log-btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 8px 14px; border: 1px solid var(--global-theme-color);
      border-radius: 4px; font-size: 0.8rem; font-weight: 500;
      color: var(--global-text-color) !important; text-decoration: none !important;
      transition: all 0.2s ease-in-out; background: transparent;
      min-width: 80px;
    }
    .log-btn:hover { 
      background-color: var(--global-theme-color); 
      color: white !important; 
    }
    .log-btn i { margin-right: 6px; font-size: 0.9rem; }

    /* Responsif untuk HP */
    @media (max-width: 576px) {
      .log-item { flex-direction: column; align-items: flex-start; }
      .log-actions { margin-top: 15px; }
    }
  </style>
</head>

<body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
  {% include header.liquid %}

  <div class="container mt-5" role="main">
    
    {% if page.title %}
      <header class="post-header mb-5">
        <h1 class="post-title font-weight-bold">{{ page.title }}</h1>
        {% if page.subtitle %}
          <p class="page-subtitle font-weight-bold" style="color: var(--global-theme-color) !important;">{{ page.subtitle }}</p>
        {% endif %}
        {% if page.description %}
          <p class="post-description">{{ page.description | markdownify }}</p>
        {% endif %}
        <hr>
      </header>
    {% endif %}

    <div class="logs-list">
      {% assign entries = site.logs | sort: 'date' | reverse %}
      {% for entry in entries %}
        <div class="log-item">
          <div class="log-content">
            <span class="log-title">{{ entry.title }}</span>
            {% if entry.description %}
              <p class="log-desc">{{ entry.description }}</p>
            {% endif %}
          </div>

          <div class="log-actions">
            {% if entry.btn1_link %}
              <a href="{{ entry.btn1_link }}" class="log-btn" target="_blank">
                <i class="fas fa-link"></i> {{ entry.btn1_text | default: "Link" }}
              </a>
            {% endif %}

            {% if entry.btn2_link %}
              <a href="{{ entry.btn2_link }}" class="log-btn" target="_blank">
                <i class="fas fa-layer-group"></i> {{ entry.btn2_text | default: "Deck" }}
              </a>
            {% endif %}

            {% if entry.btn3_link %}
              <a href="{{ entry.btn3_link }}" class="log-btn" target="_blank">
                <i class="fas fa-sticky-note"></i> {{ entry.btn3_text | default: "Notes" }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>

  {% include footer.liquid %}
  {% include scripts.liquid %}
</body>
</html>
