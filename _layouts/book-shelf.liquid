<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include head.liquid %}
  <style>
    .book-item { display: flex; gap: 25px; margin-bottom: 40px; align-items: flex-start; }
    .book-cover img { width: 120px; border-radius: 4px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); transition: transform 0.2s; }
    .book-cover img:hover { transform: scale(1.05); }
    .book-info { flex: 1; }
    .book-title { font-size: 1.4rem; font-weight: bold; margin-bottom: 5px; color: var(--global-text-color); }
    .book-meta { font-size: 0.9rem; opacity: 0.7; margin-bottom: 15px; }
    .book-details { font-size: 1rem; line-height: 1.5; margin-bottom: 8px; }
    .book-details strong { color: var(--global-theme-color); font-weight: 600; }
    .show-more { font-size: 0.9rem; text-decoration: underline !important; color: var(--global-theme-color) !important; font-weight: 500; }
  </style>
</head>

<body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
  {% include header.liquid %}

  <div class="container mt-5" role="main">
    <header class="post-header mb-5">
      <h1 class="post-title font-weight-bold">{{ page.title }}</h1>
      {% if page.subtitle %}<p class="page-subtitle font-weight-bold" style="color: var(--global-theme-color) !important;">{{ page.subtitle }}</p>{% endif %}
      {% if page.description %}<div class="post-description">{{ page.description | markdownify }}</div>{% endif %}
      <hr>
    </header>

          <div class="books-list">
            {% assign my_books = site.books | sort: 'date' | reverse %}
            {% for book in my_books %}
              <div class="book-item">
                <div class="book-cover">
                   <a href="{{ book.url | relative_url }}">
                      {% if book.cover %}
                        <img src="{{ book.cover | relative_url }}" alt="{{ book.title }}">
                      {% endif %}
                   </a>
                </div>
                <div class="book-info">
                   <div class="book-title">{{ book.title }}</div>
                   </div>
              </div>
            {% empty %}
              <p>No books found in _books folder.</p>
            {% endfor %}
          </div>

          <div class="book-info">
            <div class="book-title">{{ book.title }}</div>
            <div class="book-meta">by {{ book.author }} &middot; {{ book.date | date: '%Y' }}</div>
            
            {% if book.obsession %}
            <div class="book-details">
              <strong>Why I'm obsessed:</strong> {{ book.obsession }}
            </div>
            {% endif %}

            {% if book.fav_character %}
            <div class="book-details">
              <strong>Favorite Character:</strong> {{ book.fav_character }}
            </div>
            {% endif %}

            <div class="mt-2">
              <a href="{{ book.url | relative_url }}" class="show-more">Show more...</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% include footer.liquid %}
  {% include scripts.liquid %}
</body>
</html>
