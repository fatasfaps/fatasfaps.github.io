<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include head.liquid %}
  <style>
    .scribble-item { border-bottom: 1px solid var(--global-divider-color); }
    .scribble-trigger {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 10px; text-decoration: none !important;
      color: var(--global-text-color) !important; cursor: pointer;
    }
    .scribble-trigger:hover { background-color: var(--global-hover-color); }
    .scribble-title { font-size: 1.25rem; font-weight: 600; }
    .scribble-date { font-family: 'Roboto Mono', monospace; font-size: 0.9rem; opacity: 0.7; }
    .scribble-body { padding: 0 15px 30px 15px; font-size: 1.05rem; line-height: 1.6; }
    .scribble-trigger[aria-expanded="true"] i { transform: rotate(180deg); }
    .scribble-trigger i { transition: transform 0.3s ease; }
  </style>
</head>

<body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
  {% include header.liquid %}

  <div class="container mt-5" role="main">
    <header class="post-header mb-5">
      <h1 class="post-title font-weight-bold">{{ page.title }}</h1>
      
      {% if page.subtitle %}
        <p class="page-subtitle font-italic" style="color: var(--global-theme-color) !important; font-size: 1.2rem;">
          {{ page.subtitle }}
        </p>
      {% endif %}

      {% if page.description %}
        <div class="post-description" style="font-size: 1rem; opacity: 0.9;">
          {{ page.description | markdownify }}
        </div>
      {% endif %}
      <hr>
    </header>

    <div class="scribbles-list">
      {% assign entries = site.scribbles | sort: 'date' | reverse %}
      {% for entry in entries %}
        <div class="scribble-item">
          <a class="scribble-trigger" data-toggle="collapse" href="#content-{{ forloop.index }}" role="button" aria-expanded="false">
            <span class="scribble-title">{{ entry.title }}</span>
            <div>
              <span class="scribble-date mr-3">{{ entry.date | date: "%b %d, %Y" }}</span>
              <i class="fas fa-chevron-down"></i>
            </div>
          </a>
          <div class="collapse" id="content-{{ forloop.index }}">
            <div class="scribble-body">
              {{ entry.content }}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    </div>

  {% include footer.liquid %}
  {% include scripts.liquid %}
</body>
</html>
