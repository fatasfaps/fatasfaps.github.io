<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include head.liquid %}
  <style>
    /* Layout List Buku/Movie */
    .book-item { display: flex; gap: 25px; margin-bottom: 40px; align-items: flex-start; }
    .book-cover img { width: 150px; border-radius: 4px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); transition: transform 0.2s; }
    .book-cover img:hover { transform: scale(1.02); }
    .book-info { flex: 1; }
    
    /* Tipografi */
    .book-title { font-size: 1.6rem; font-weight: bold; margin-bottom: 5px; color: var(--global-text-color); }
    .book-meta { font-size: 0.95rem; opacity: 0.7; margin-bottom: 15px; }
    .book-details { font-size: 1rem; line-height: 1.5; margin-bottom: 8px; }
    .book-details strong { color: var(--global-theme-color); font-weight: 600; }
    
    /* Tombol Show More */
    .show-more { font-size: 0.9rem; text-decoration: underline !important; color: var(--global-theme-color) !important; font-weight: 500; }
  </style>
</head>

<body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
  {% include header.liquid %}

  <div class="container mt-5" role="main">
    
    {% if page.title %}
      <header class="post-header mb-5">
        <h1 class="post-title font-weight-bold">{{ page.title }}</h1>
      
        {% if page.subtitle %}
          <p class="page-subtitle font-weight-bold" style="color: var(--global-theme-color) !important;">
            {{ page.subtitle }}
          </p>
        {% endif %}
      
        {% if page.description %}
          <div class="post-description">
            {{ page.description | markdownify }}
          </div>
        {% endif %}
        <hr>
      </header>
    {% endif %}

    <div class="post-content mb-5">
      {{ content }}
    </div>

    <div class="books-list">
      {% assign collection_name = page.collection %}
      {% assign items = site[collection_name] | sort: 'date' | reverse %}
      
      {% for item in items %}
        <div class="book-item">
          <div class="book-cover">
            <a href="{{ item.url | relative_url }}">
              {% if item.cover %}
                <img src="{{ item.cover | relative_url }}" alt="{{ item.title }}">
              {% elsif item.isbn %}
                <img src="https://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false" alt="{{ item.title }}">
              {% endif %}
            </a>
          </div>

          <div class="book-info">
            <div class="book-title">{{ item.title }}</div>
            <div class="book-meta">
              {% if collection_name == 'books' %}by {{ item.author }}{% else %}dir. {{ item.director }}{% endif %} &middot; {{ item.date | date: '%Y' }}
            </div>
            
            {% if item.obsession %}
              <div class="book-details">
                <strong>Why I'm obsessed:</strong> {{ item.obsession }}
              </div>
            {% endif %}

            {% if item.fav_character %}
              <div class="book-details">
                <strong>Favorite Character:</strong> {{ item.fav_character }}
              </div>
            {% endif %}

            <div class="mt-2">
              <a href="{{ item.url | relative_url }}" class="show-more">Show more...</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>

  {% include footer.liquid %}
  {% include scripts.liquid %}
</body>
</html>
