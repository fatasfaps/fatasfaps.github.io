<div class="col">
  <div class="card h-100 project-card-new">
    <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}" class="project-card-link">
      
      <div class="project-img-top">
        {% if project.img %}
          <img src="{{ project.img | relative_url }}" alt="{{ project.title }}" loading="lazy">
        {% else %}
          <div class="placeholder-img"></div>
        {% endif %}
      </div>

      <div class="card-body project-body-content">
        <h2 class="project-card-title">{{ project.title }}</h2>
        
        {% if project.date_start and project.date_end %}
          <div class="project-card-duration">
            {{ project.duration }}
            {% assign start = project.date_start | date: '%s' %}
            {% assign end = project.date_end | date: '%s' %}
            {% assign seconds = end | minus: start %}
            {% assign months = seconds | divided_by: 2592000 | plus: 1 %}
            <span class="mos-tag">({{ months }} mos)</span>
          </div>
        {% endif %}

        <p class="project-card-desc">{{ project.description }}</p>
      </div>
    </a>

    <div class="project-card-footer">
      <div class="project-btn-cluster">
        {% if project.github_link %}
          <a href="{{ project.github_link }}" class="p-custom-btn" target="_blank" title="GitHub">
            <i class="fa-brands fa-github"></i>
            {% if project.github_text %}<span>{{ project.github_text }}</span>{% endif %}
          </a>
        {% endif %}
        
        {% if project.db_link %}
          <a href="{{ project.db_link }}" class="p-custom-btn" target="_blank" title="Database">
            <i class="fa-solid fa-database"></i>
            {% if project.db_text %}<span>{{ project.db_text }}</span>{% endif %}
          </a>
        {% endif %}
        
        {% if project.pdf_link %}
          <a href="{{ project.pdf_link }}" class="p-custom-btn" target="_blank" title="PDF">
            <i class="fa-solid fa-file-pdf"></i>
            {% if project.pdf_text %}<span>{{ project.pdf_text }}</span>{% endif %}
          </a>
        {% endif %}
        
        {% if project.chain_link %}
          <a href="{{ project.chain_link }}" class="p-custom-btn" target="_blank" title="Chain">
            <i class="fa-solid fa-link"></i>
            {% if project.chain_text %}<span>{{ project.chain_text }}</span>{% endif %}
          </a>
        {% endif %}
        
        {% if project.deck_link %}
          <a href="{{ project.deck_link }}" class="p-custom-btn" target="_blank" title="Deck">
            <i class="fa-solid fa-layer-group"></i>
            {% if project.deck_text %}<span>{{ project.deck_text }}</span>{% endif %}
          </a>
        {% endif %}
        
        {% if project.note_link %}
          <a href="{{ project.note_link }}" class="p-custom-btn" target="_blank" title="Note">
            <i class="fa-solid fa-sticky-note"></i>
            {% if project.note_text %}<span>{{ project.note_text }}</span>{% endif %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .project-card-new {
    border: 1px solid var(--global-divider-color);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background: var(--global-card-bg-color);
  }
  .project-card-new:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .project-card-link { text-decoration: none !important; color: inherit !important; }

  .project-img-top { width: 100%; height: 200px; overflow: hidden; }
  .project-img-top img { width: 100%; height: 100%; object-fit: cover; }
  .placeholder-img { width: 100%; height: 100%; background: var(--global-hover-color); }

  .project-body-content { padding: 1.25rem; }
  .project-card-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
  .project-card-duration { 
    font-family: 'Roboto Mono', monospace; font-size: 0.8rem; 
    opacity: 0.7; margin-bottom: 12px; 
  }
  .mos-tag { font-weight: bold; color: var(--global-theme-color); }
  .project-card-desc { font-size: 0.95rem; opacity: 0.6; line-height: 1.5; margin-bottom: 0; }

  .project-card-footer { padding: 0 1.25rem 1.25rem 1.25rem; }
  .project-btn-cluster { display: flex; gap: 8px; flex-wrap: wrap; }
  .p-custom-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 6px 12px; border: 1px solid var(--global-theme-color);
    border-radius: 6px; font-size: 0.75rem; font-weight: 600;
    color: var(--global-theme-color) !important; text-decoration: none !important;
    transition: 0.2s;
  }
  .p-custom-btn:hover { background: var(--global-theme-color); color: white !important; }
  .p-custom-btn i { font-size: 0.85rem; }
  .p-custom-btn span { margin-left: 6px; }
</style>
